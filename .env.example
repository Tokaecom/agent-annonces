# Template des secrets attendus par le projet
# Copier ce fichier en .env et remplir les vraies valeurs
# Le fichier .env est ignoré par git (cf. .gitignore)

# Token du bot Telegram (créé via @BotFather)
# JAMAIS partager ce token, JAMAIS le commit
TELEGRAM_BOT_TOKEN=

# ID de ton compte Telegram (récupéré via @userinfobot)
# Moins sensible que le token mais on le met dans .env par hygiène
TELEGRAM_CHAT_ID=

# Clé API Anthropic pour appeler Claude (créée sur console.anthropic.com)
# JAMAIS partager cette clé, JAMAIS la commit
ANTHROPIC_API_KEY=
